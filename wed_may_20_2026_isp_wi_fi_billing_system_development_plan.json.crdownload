    "src/settings/settings.service.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/settings/settings.service.ts#13.279",
        "language": "ts",
        "name": "src/settings/settings.service.ts",
        "value": "import { Injectable, NotFoundException } from '@nestjs/common';\nimport { InjectRepository } from '@nestjs/typeorm';\nimport { Repository } from 'typeorm';\nimport { TenantSettings } from '../entities/tenant-settings.entity';\n\n@Injectable()\nexport class SettingsService {\n  constructor(\n    @InjectRepository(TenantSettings)\n    private readonly repo: Repository<TenantSettings>,\n  ) {}\n\n  async getSettingsForTenant(tenantId: string) {\n    const row = await this.repo.findOne({ where: { tenantId } });\n    if (!row) {\n      return {\n        tenantId,\n        settings: {\n          billing_cycle: 'monthly',\n          currency: 'USD',\n          theme: { primaryColor: '#0ea5e9', darkMode: false },\n          pppoe: { enabled: true },\n          hotspot: { enabled: true },\n          payments: { enabled: true, providers: [] },\n          olts: { enabled: false }\n        },\n        featureFlags: {}\n      };\n    }\n    return row;\n  }\n\n  async upsertSettings(tenantId: string, payload: { settings?: any; featureFlags?: any; updatedBy?: string; }) {\n    let row = await this.repo.findOne({ where: { tenantId } });\n    if (!row) {\n      row = this.repo.create({\n        tenantId,\n        settings: payload.settings || {},\n        featureFlags: payload.featureFlags || {},\n        updatedBy: payload.updatedBy\n      });\n      return this.repo.save(row);\n    }\n    row.settings = { ...row.settings, ...(payload.settings || {}) };\n    row.featureFlags = { ...row.featureFlags, ...(payload.featureFlags || {}) };\n    row.updatedBy = payload.updatedBy;\n    return this.repo.save(row);\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "src/settings/settings.controller.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/settings/settings.controller.ts#13.332",
        "language": "ts",
        "name": "src/settings/settings.controller.ts",
        "value": "import { Controller, Get, Put, Param, Body, UseGuards, Req, HttpException, HttpStatus } from '@nestjs/common';\nimport { SettingsService } from './settings.service';\nimport { IsObject, IsOptional } from 'class-validator';\nimport { plainToInstance } from 'class-transformer';\n\n// Note: Provide real guards in your app (AuthGuard, RolesGuard).\n// Roles decorator and guards are assumed to exist in your project.\n\nclass UpdateSettingsDto {\n  @IsOptional()\n  @IsObject()\n  settings?: Record<string, any>;\n\n  @IsOptional()\n  @IsObject()\n  featureFlags?: Record<string, any>;\n}\n\n@Controller('api/admin/:tenantId/settings')\nexport class SettingsController {\n  constructor(private readonly settingsService: SettingsService) {}\n\n  @Get()\n  async get(@Param('tenantId') tenantId: string) {\n    if (!tenantId) throw new HttpException('tenantId required', HttpStatus.BAD_REQUEST);\n    return this.settingsService.getSettingsForTenant(tenantId);\n  }\n\n  @Put()\n  async put(@Param('tenantId') tenantId: string, @Body() body: any, @Req() req: any) {\n    // Validate body\n    const dto = plainToInstance(UpdateSettingsDto, body || {});\n    // class-validator can be used via ValidationPipe at controller level in your app\n    const updated = await this.settingsService.upsertSettings(tenantId, {\n      settings: dto.settings,\n      featureFlags: dto.featureFlags,\n      updatedBy: req.user?.id\n    });\n    return updated;\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "src/auth/email-verification.service.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/auth/email-verification.service.ts#13.377",
        "language": "ts",
        "name": "src/auth/email-verification.service.ts",
        "value": "import { Injectable, Logger, HttpException, HttpStatus } from '@nestjs/common';\nimport { InjectRepository } from '@nestjs/typeorm';\nimport { Repository } from 'typeorm';\nimport { EmailVerificationToken } from '../entities/email-verification-token.entity';\nimport { randomBytes } from 'crypto';\nimport * as dayjs from 'dayjs';\nimport { sendEmail } from '../utils/mailer';\n\n@Injectable()\nexport class EmailVerificationService {\n  private readonly logger = new Logger(EmailVerificationService.name);\n\n  constructor(\n    @InjectRepository(EmailVerificationToken)\n    private readonly repo: Repository<EmailVerificationToken>,\n  ) {}\n\n  async createAndSend(user: { id: string; email: string; name?: string }) {\n    const token = randomBytes(24).toString('hex'); // 48 hex chars\n    const expiresAt = dayjs().add(24, 'hour').toDate();\n\n    const row = this.repo.create({\n      userId: user.id,\n      token,\n      expiresAt\n    });\n    await this.repo.save(row);\n\n    const verificationUrl = `${process.env.APP_URL}/auth/verify-email?token=${token}`;\n    const subject = 'Verify your email';\n    const text = `Hi ${user.name || ''},\\n\\nPlease verify your email by clicking the link below:\\n\\n${verificationUrl}\\n\\nThis link expires in 24 hours.\\n\\nIf you did not request this, ignore this email.`;\n\n    await sendEmail(user.email, subject, text).catch(err => {\n      this.logger.error('Failed to send verification email', err);\n      // don't throw — still keep the token so user can request resend\n    });\n\n    this.logger.log(`Verification email created for ${user.email}`);\n    return { sent: true };\n  }\n\n  async verify(token: string) {\n    const row = await this.repo.findOne({ where: { token } });\n    if (!row) throw new HttpException('Invalid token', HttpStatus.BAD_REQUEST);\n    if (row.used) throw new HttpException('Token already used', HttpStatus.BAD_REQUEST);\n    if (new Date() > row.expiresAt) throw new HttpException('Token expired', HttpStatus.BAD_REQUEST);\n\n    row.used = true;\n    await this.repo.save(row);\n    return row.userId;\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "src/users/users.service.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/users/users.service.ts#13.433",
        "language": "ts",
        "name": "src/users/users.service.ts",
        "value": "import { Injectable } from '@nestjs/common';\nimport { InjectRepository } from '@nestjs/typeorm';\nimport { Repository } from 'typeorm';\nimport { User } from '../entities/user.entity';\nimport * as bcrypt from 'bcrypt';\n\n@Injectable()\nexport class UsersService {\n  constructor(\n    @InjectRepository(User)\n    private readonly repo: Repository<User>,\n  ) {}\n\n  async create(payload: { email: string; name?: string; password: string; tenantId?: string }) {\n    const existing = await this.repo.findOne({ where: { email: payload.email } });\n    if (existing) throw new Error('Email already in use');\n    const passwordHash = await bcrypt.hash(payload.password, 12);\n    const user = this.repo.create({\n      email: payload.email,\n      name: payload.name,\n      passwordHash,\n      tenantId: payload.tenantId,\n      roles: ['CUSTOMER'],\n      emailVerified: false\n    });\n    return this.repo.save(user);\n  }\n\n  async markEmailVerified(userId: string) {\n    const user = await this.repo.findOne({ where: { id: userId } });\n    if (!user) throw new Error('User not found');\n    user.emailVerified = true;\n    return this.repo.save(user);\n  }\n\n  async findByEmail(email: string) {\n    return this.repo.findOne({ where: { email } });\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "src/auth/auth.controller.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/auth/auth.controller.ts#13.476",
        "language": "ts",
        "name": "src/auth/auth.controller.ts",
        "value": "import { Controller, Post, Body, Get, Query, HttpException, HttpStatus } from '@nestjs/common';\nimport { UsersService } from '../users/users.service';\nimport { EmailVerificationService } from './email-verification.service';\n\n@Controller('api/auth')\nexport class AuthController {\n  constructor(\n    private readonly users: UsersService,\n    private readonly ev: EmailVerificationService,\n  ) {}\n\n  @Post('register')\n  async register(@Body() body: { email: string; password: string; name?: string; tenantId?: string; }) {\n    if (!body.email || !body.password) {\n      throw new HttpException('email and password required', HttpStatus.BAD_REQUEST);\n    }\n    const user = await this.users.create({ email: body.email, password: body.password, name: body.name, tenantId: body.tenantId });\n    await this.ev.createAndSend(user);\n    return { message: 'User created. Verification email sent.' };\n  }\n\n  @Get('verify-email')\n  async verifyEmail(@Query('token') token: string) {\n    if (!token) throw new HttpException('token required', HttpStatus.BAD_REQUEST);\n    const userId = await this.ev.verify(token);\n    await this.users.markEmailVerified(userId);\n    return { message: 'Email verified' };\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "src/utils/mailer.ts": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:src/utils/mailer.ts#13.509",
        "language": "ts",
        "name": "src/utils/mailer.ts",
        "value": "import nodemailer from 'nodemailer';\nimport SMTPTransport from 'nodemailer/lib/smtp-transport';\n\nconst transporter = nodemailer.createTransport({\n  host: process.env.SMTP_HOST,\n  port: Number(process.env.SMTP_PORT || 587),\n  secure: process.env.SMTP_SECURE === 'true', // true for 465, false for other ports\n  auth: process.env.SMTP_USER ? { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS } : undefined,\n  tls: { rejectUnauthorized: process.env.SMTP_REJECT_UNAUTHORIZED !== 'false' }\n} as SMTPTransport.Options);\n\nexport async function sendEmail(to: string, subject: string, text: string, html?: string) {\n  if (!process.env.SMTP_HOST) {\n    // In dev you may want to log or use Ethereal\n    console.warn('SMTP not configured, skipping sendEmail. To test, set SMTP_* env vars or use Ethereal.');\n    return;\n  }\n  await transporter.sendMail({\n    from: process.env.FROM_EMAIL || 'no-reply@yourapp.local',\n    to,\n    subject,\n    text,\n    html\n  });\n}",
