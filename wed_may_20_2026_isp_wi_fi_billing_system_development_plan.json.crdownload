    "services/settings/settings.service.ts": [
      {
        "version": 1,
        "messageId": "274e3b5c-fd71-416d-ab52-79f1d84ab4ce",
        "id": "file:services/settings/settings.service.ts#11.95",
        "language": "typescript",
        "name": "services/settings/settings.service.ts",
        "value": "import { Injectable, NotFoundException } from '@nestjs/common';\nimport { InjectRepository } from '@nestjs/typeorm';\nimport { Repository } from 'typeorm';\n\ninterface TenantSettings {\n  tenant_id: string;\n  settings: any;\n  feature_flags: any;\n  updated_by?: string;\n}\n\n@Injectable()\nexport class SettingsService {\n  constructor(\n    @InjectRepository('tenant_settings')\n    private readonly settingsRepo: Repository<any>,\n  ) {}\n\n  async getSettings(tenantId: string) {\n    const s = await this.settingsRepo.findOne({ where: { tenant_id: tenantId } });\n    if (!s) {\n      // return defaults\n      return {\n        tenant_id: tenantId,\n        settings: {\n          billing_cycle: 'monthly',\n          currency: 'USD',\n          theme: {},\n          pppoe: { enabled: true },\n          hotspot: { enabled: true },\n          payments: { enabled: true, providers: [] },\n          olts: { enabled: false }\n        },\n        feature_flags: {}\n      };\n    }\n    return s;\n  }\n\n  async upsertSettings(tenantId: string, payload: TenantSettings) {\n    const existing = await this.settingsRepo.findOne({ where: { tenant_id: tenantId } });\n    if (!existing) {\n      const newRow = this.settingsRepo.create({\n        tenant_id: tenantId,\n        settings: payload.settings || {},\n        feature_flags: payload.feature_flags || {},\n        updated_by: payload.updated_by\n      });\n      return this.settingsRepo.save(newRow);\n    }\n    existing.settings = payload.settings ?? existing.settings;\n    existing.feature_flags = payload.feature_flags ?? existing.feature_flags;\n    existing.updated_by = payload.updated_by;\n    existing.updated_at = new Date();\n    return this.settingsRepo.save(existing);\n  }\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:34:56.505Z",
        "isStreaming": false,
        "isUserEdited": false
      }
