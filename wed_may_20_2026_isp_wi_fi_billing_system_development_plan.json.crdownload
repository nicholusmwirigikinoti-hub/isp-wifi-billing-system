        "isUserEdited": false
      }
    ],
    "apps/admin-portal/pages/admin/settings.tsx": [
      {
        "version": 1,
        "messageId": "274e3b5c-fd71-416d-ab52-79f1d84ab4ce",
        "id": "file:apps/admin-portal/pages/admin/settings.tsx#11.338",
        "language": "tsx",
        "name": "apps/admin-portal/pages/admin/settings.tsx",
        "value": "import React, { useEffect, useState } from 'react';\nimport axios from 'axios';\n\nexport default function AdminSettings({ initialTenantId }) {\n  const tenantId = initialTenantId || 'REPLACE_TENANT_ID';\n  const [loading, setLoading] = useState(true);\n  const [settings, setSettings] = useState(null);\n  const [featureFlags, setFeatureFlags] = useState({});\n\n  useEffect(() => {\n    async function load() {\n      setLoading(true);\n      const res = await axios.get(`/api/admin/${tenantId}/settings`);\n      setSettings(res.data.settings || {});\n      setFeatureFlags(res.data.feature_flags || {});\n      setLoading(false);\n    }\n    load();\n  }, [tenantId]);\n\n  if (loading) return <div>Loading...</div>;\n\n  async function save() {\n    await axios.put(`/api/admin/${tenantId}/settings`, { settings, feature_flags: featureFlags });\n    alert('Saved');\n  }\n\n  return (\n    <div className=\"p-6\">\n      <h1 className=\"text-2xl font-bold mb-4\">Main Admin - Tenant Settings</h1>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Feature Flags</h2>\n        {['pppoe','hotspot','payments','olts','reseller','white_label','notifications'].map(f => (\n          <div key={f} className=\"flex items-center my-2\">\n            <label className=\"flex-1\">{f}</label>\n            <input\n              type=\"checkbox\"\n              checked={!!featureFlags[f]}\n              onChange={(e) => setFeatureFlags({...featureFlags, [f]: e.target.checked})}\n              />\n          </div>\n        ))}\n      </section>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Billing</h2>\n        <label>Billing cycle</label>\n        <select value={settings.billing_cycle || 'monthly'} onChange={e => setSettings({...settings, billing_cycle: e.target.value})}>\n          <option value=\"monthly\">Monthly</option>\n          <option value=\"weekly\">Weekly</option>\n          <option value=\"daily\">Daily</option>\n        </select>\n      </section>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Theme</h2>\n        <label>Primary color</label>\n        <input value={settings.theme?.primaryColor || ''} onChange={e => setSettings({...settings, theme: {...settings.theme, primaryColor: e.target.value}})} />\n      </section>\n\n      <button className=\"px-4 py-2 bg-blue-600 text-white rounded\" onClick={save}>Save Settings</button>\n    </div>\n  );\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:34:56.505Z",
        "isStreaming": false,
        "isUserEdited": false
      },
      {
        "version": 2,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:apps/admin-portal/pages/admin/settings.tsx#13.538",
        "language": "tsx",
        "name": "apps/admin-portal/pages/admin/settings.tsx",
        "value": "import React, { useEffect, useState } from 'react';\n\ntype SettingsPayload = {\n  settings: Record<string, any>;\n  featureFlags: Record<string, boolean>;\n};\n\nexport default function AdminSettings({ tenantId }: { tenantId: string }) {\n  const [loading, setLoading] = useState(true);\n  const [payload, setPayload] = useState<SettingsPayload>({ settings: {}, featureFlags: {} });\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    if (!tenantId) return;\n    fetch(`/api/admin/${tenantId}/settings`, { credentials: 'include' })\n      .then(async res => {\n        if (!res.ok) throw new Error(await res.text());\n        return res.json();\n      })\n      .then(data => {\n        setPayload({\n          settings: data.settings || {},\n          featureFlags: data.featureFlags || data.feature_flags || {}\n        });\n      })\n      .catch(err => setError(err.message || 'Failed to load'))\n      .finally(() => setLoading(false));\n  }, [tenantId]);\n\n  if (loading) return <div>Loading...</div>;\n  if (error) return <div className=\"text-red-600\">Error: {error}</div>;\n\n  function toggleFeature(flag: string) {\n    setPayload(prev => ({ ...prev, featureFlags: { ...prev.featureFlags, [flag]: !prev.featureFlags[flag] } }));\n  }\n\n  async function save() {\n    try {\n      const res = await fetch(`/api/admin/${tenantId}/settings`, {\n        method: 'PUT',\n        credentials: 'include',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ settings: payload.settings, featureFlags: payload.featureFlags })\n      });\n      if (!res.ok) throw new Error(await res.text());\n      alert('Saved');\n    } catch (err: any) {\n      alert('Save failed: ' + (err.message || err));\n    }\n  }\n\n  const flags = ['pppoe', 'hotspot', 'payments', 'olts', 'reseller', 'white_label', 'notifications'];\n\n  return (\n    <div className=\"p-6\">\n      <h1 className=\"text-2xl font-bold mb-4\">Main Admin - Tenant Settings</h1>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Feature Flags</h2>\n        {flags.map(f => (\n          <div key={f} className=\"flex items-center my-2\">\n            <label className=\"flex-1\">{f}</label>\n            <input\n              type=\"checkbox\"\n              checked={!!payload.featureFlags[f]}\n              onChange={() => toggleFeature(f)}\n            />\n          </div>\n        ))}\n      </section>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Billing</h2>\n        <label>Billing cycle</label>\n        <select\n          value={payload.settings.billing_cycle || 'monthly'}\n          onChange={e => setPayload(prev => ({ ...prev, settings: { ...prev.settings, billing_cycle: e.target.value } }))}\n        >\n          <option value=\"monthly\">Monthly</option>\n          <option value=\"weekly\">Weekly</option>\n          <option value=\"daily\">Daily</option>\n        </select>\n      </section>\n\n      <section className=\"mb-6\">\n        <h2 className=\"font-semibold\">Theme</h2>\n        <label>Primary color</label>\n        <input\n          value={payload.settings.theme?.primaryColor || ''}\n          onChange={e => setPayload(prev => ({ ...prev, settings: { ...prev.settings, theme: { ...prev.settings.theme, primaryColor: e.target.value } } }))}\n        />\n      </section>\n\n      <button onClick={save} className=\"px-4 py-2 bg-blue-600 text-white rounded\">Save Settings</button>\n    </div>\n  );\n}",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
    ],
    "migrations/20260520_init.sql": [
      {
        "version": 1,
        "messageId": "b714f5a1-4a79-4c6c-a9e2-6c7b268e91ae",
        "id": "file:migrations/20260520_init.sql#13.8",
        "language": "sql",
        "name": "migrations/20260520_init.sql",
        "value": "-- Initialize core tables for tenants, tenant_countries, tenant_settings, olts, users, email verification\n-- Run with your migration tool. Make sure pgcrypto extension is available for gen_random_uuid() or replace with uuid_generate_v4()\n\nCREATE EXTENSION IF NOT EXISTS \"pgcrypto\";\n\n-- Users (minimal)\nCREATE TABLE IF NOT EXISTS users (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  email text NOT NULL UNIQUE,\n  name text,\n  password_hash text NOT NULL,\n  tenant_id uuid,\n  roles text[] DEFAULT ARRAY['CUSTOMER']::text[],\n  email_verified boolean DEFAULT false,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n);\n\n-- Tenants\nCREATE TABLE IF NOT EXISTS tenants (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  name text NOT NULL,\n  slug text UNIQUE NOT NULL,\n  owner_user_id uuid,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n);\n\n-- Tenant countries (multi-country mapping)\nCREATE TABLE IF NOT EXISTS tenant_countries (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  tenant_id uuid REFERENCES tenants(id) ON DELETE CASCADE,\n  country_code varchar(3) NOT NULL,\n  currency_code varchar(3) NOT NULL,\n  tax_rate numeric DEFAULT 0,\n  default_country boolean DEFAULT false,\n  created_at timestamptz DEFAULT now(),\n  UNIQUE (tenant_id, country_code)\n);\n\n-- Tenant settings (JSONB for flexibility)\nCREATE TABLE IF NOT EXISTS tenant_settings (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  tenant_id uuid REFERENCES tenants(id) ON DELETE CASCADE,\n  settings jsonb NOT NULL DEFAULT '{}'::jsonb,\n  feature_flags jsonb NOT NULL DEFAULT '{}'::jsonb,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now(),\n  updated_by uuid\n);\nCREATE INDEX IF NOT EXISTS idx_tenant_settings_tenant ON tenant_settings(tenant_id);\n\n-- OLTs\nCREATE TABLE IF NOT EXISTS olts (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  tenant_id uuid REFERENCES tenants(id) ON DELETE CASCADE,\n  vendor varchar(64) NOT NULL,\n  name text,\n  host text NOT NULL,\n  port integer,\n  api_type varchar(32) DEFAULT 'ssh',\n  credentials jsonb,\n  region varchar(64),\n  management_url text,\n  enabled boolean DEFAULT true,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n);\nCREATE INDEX IF NOT EXISTS idx_olts_tenant ON olts(tenant_id);\n\n-- Email verification tokens\nCREATE TABLE IF NOT EXISTS email_verification_tokens (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  user_id uuid REFERENCES users(id) ON DELETE CASCADE,\n  token varchar(128) NOT NULL UNIQUE,\n  expires_at timestamptz NOT NULL,\n  used boolean DEFAULT false,\n  created_at timestamptz DEFAULT now()\n);\nCREATE INDEX IF NOT EXISTS idx_email_verification_user ON email_verification_tokens(user_id);",
        "type": "file",
        "timestamp": "2026-05-20T07:38:03.200Z",
        "isStreaming": false,
        "isUserEdited": false
      }
