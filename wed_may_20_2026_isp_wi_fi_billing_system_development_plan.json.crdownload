        "value": "import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn, UpdateDateColumn } from 'typeorm';\n\n@Entity({ name: 'olts' })\nexport class Olt {\n  @PrimaryGeneratedColumn('uuid')\n  id: string;\n\n  @Column({ type: 'uuid' })\n  tenantId: string;\n\n  @Column()\n  vendor: string;\n\n  @Column({ nullable: true })\n  name?: string;\n\n  @Column()\n  host: string;\n\n  @Column({ nullable: true })\n  port?: number;\n\n  @Column({ default: 'ssh' })\n  apiType: string;\n\n  @Column({ type: 'jsonb', nullable: true })\n  credentials?: any;\n\n  @Column({ nullable: true })\n  region?: string;\n\n  @Column({ nullable: true })\n  managementUrl?: string;\n\n  @Column({ default: true })\n  enabled: boolean;\n\n  @CreateDateColumn({ name: 'created_at' })\n  createdAt: Date;\n\n  @UpdateDateColumn({ name: 'updated_at' })\n  updatedAt: Date;\n}",
