        "language": "ts",
        "name": "src/entities/email-verification-token.entity.ts",
        "value": "import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn } from 'typeorm';\n\n@Entity({ name: 'email_verification_tokens' })\nexport class EmailVerificationToken {\n  @PrimaryGeneratedColumn('uuid')\n  id: string;\n\n  @Column({ type: 'uuid' })\n  userId: string;\n\n  @Column({ unique: true })\n  token: string;\n\n  @Column({ type: 'timestamptz' })\n  expiresAt: Date;\n\n  @Column({ default: false })\n  used: boolean;\n\n  @CreateDateColumn({ name: 'created_at' })\n  createdAt: Date;\n}",
